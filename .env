# Réglages du projet (lus par src/config.py)
# Le nom de ton groupe : il apparaît dans MLflow et dans le nom du livrable
GROUPE=groupe-coffee-shop
# Le dossier de tes données : ontologie.yaml + train.csv / validation.csv / test.csv
DONNEES_DIR=donnees

MODEL_NAME=Qwen/Qwen3-0.6B
TRAIN_MAX_STEPS=150
TRAIN_LEARNING_RATE=2e-4
TRAIN_EVAL_STEPS=10
LORA_R=8
LORA_ALPHA=16

# Porte de qualité (TP3)
EVAL_GATE_MIN_INTENT=0.70
EVAL_GATE_MARGIN=0.30
# Exigence sur les slots (0 = aucune). À décider AVANT de lire le test.
EVAL_GATE_MIN_SLOT_F1=0
EVAL_GATE_STRICT=false
# Prompt système de la colonne base+prompt : choisi sur la VALIDATION
PROMPT_SYSTEME_FILE=prompts/systeme.txt

# MLflow / RustFS (stockage S3)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=projet-nlu
MLFLOW_PROMPT_EXPERIMENT_NAME=projet-prompt-lab
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
